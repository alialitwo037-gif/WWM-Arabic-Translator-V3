<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wwm.arabictranslator">

    <!-- صلاحية الإنترنت للاتصال بـ Gemini API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- صلاحية إظهار نافذة الترجمة العائمة فوق لعبة Wuthering Waves -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Wwm Arabic Translator V3"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- النشاط الرئيسي للتطبيق -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- الشاشات والنشاطات الفرعية -->
        <activity android:name=".WwmAiActivity" />
        <activity android:name=".OverlaySettingsActivity" />
        <activity android:name=".TranslationMemoryActivity" />
        <activity android:name=".SettingsActivity" />

        <!-- الخدمة الخلفية للنافذة العائمة -->
        <service
            android:name=".WwmOverlayService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
