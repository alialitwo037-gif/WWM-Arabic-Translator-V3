<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wwm.arabictranslator">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="WWM Arabic Translator"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- الشاشة الرئيسية -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- شاشة WWM AI -->
        <activity
            android:name=".ai.WwmAiActivity"
            android:exported="false"
            android:label="WWM AI" />

        <!-- شاشة قاموس المصطلحات -->
        <activity
            android:name=".glossary.GlossaryActivity"
            android:exported="false"
            android:label="قاموس المصطلحات" />

        <!-- شاشة ذاكرة الترجمة -->
        <activity
            android:name=".memory.TranslationMemoryActivity"
            android:exported="false"
            android:label="ذاكرة الترجمة" />

        <!-- شاشة إعدادات Overlay -->
        <activity
            android:name=".ui.OverlaySettingsActivity"
            android:exported="false"
            android:label="إعدادات الـ Overlay" />

        <!-- خدمة الترجمة والتراكب -->
        <service
            android:name=".service.TranslatorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
