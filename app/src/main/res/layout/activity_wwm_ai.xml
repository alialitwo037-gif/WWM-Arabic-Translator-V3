<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- عنوان الشاشة -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إعدادات الذكاء الاصطناعي"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp" />

    <!-- حقل إدخال مفتاح الـ API -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مفتاح الـ API الخاص (API Key):"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1E1E1E"
        android:textColor="#FFFFFF"
        android:textColorHint="#757575"
        android:hint="أدخل مفتاح الـ API هنا..."
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp" />

    <!-- اختيار نموذج الذكاء الاصطناعي -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اختر نموذج الذكاء الاصطناعي:"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerAiModel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1E1E1E"
        android:layout_marginBottom="40dp" />

    <!-- زر الحفظ الفعلي والعميق -->
    <Button
        android:id="@+id/btnSaveAiSettings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#8B0000"
        android:text="حفظ الإعدادات نهائياً"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
