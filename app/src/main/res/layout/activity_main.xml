<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wwm Arabic Translator V3"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لوحة التحكم الرئيسية - الأزرار الستة الأولى"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- 1. إعدادات المساعد والذكاء الاصطناعي -->
        <Button
            android:id="@+id/btnAiSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1E1E1E"
            android:text="1. إعدادات المساعد والذكاء الاصطناعي"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:layout_marginBottom="10dp" />

        <!-- 2. إدارة الذاكرة والمفاتيح -->
        <Button
            android:id="@+id/btnPreferencesHelper"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1E1E1E"
            android:text="2. إدارة الذاكرة ومفاتيح الربط"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:layout_marginBottom="10dp" />

        <!-- 3. واجهة الترجمة المتقدمة -->
        <Button
            android:id="@+id/btnTranslationInterface"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1E1E1E"
            android:text="3. واجهة الترجمة المتقدمة"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:layout_marginBottom="10dp" />

        <!-- 4. إعدادات الـ Overlay للشاشة -->
        <Button
            android:id="@+id/btnOverlaySettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1E1E1E"
            android:text="4. إعدادات الـ Overlay والشاشة"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:layout_marginBottom="10dp" />

        <!-- 5. ذاكرة الترجمة والمصطلحات -->
        <Button
            android:id="@+id/btnTranslationMemory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1E1E1E"
            android:text="5. ذاكرة الترجمة والمصطلحات"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:layout_marginBottom="10dp" />

        <!-- 6. الإعدادات العامة -->
        <Button
            android:id="@+id/btnGeneralSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1E1E1E"
            android:text="6. الإعدادات العامة الشاملة"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvStatusInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الحالة: جميع الأزرار الستة متصلة وجاهزة"
            android:textColor="#757575"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
