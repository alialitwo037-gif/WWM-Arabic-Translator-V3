<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الإعدادات العامة"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnTranslatingSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#1E1E1E"
        android:text="إعدادات الترجمة (اللغة والـ API)"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOverlaySettingsMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#1E1E1E"
        android:text="إعدادات الـ Overlay والشاشة"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnDataSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#1E1E1E"
        android:text="البيانات وذاكرة الترجمة (Import / Export)"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAboutApp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#1E1E1E"
        android:text="حول التطبيق ومعلومات النسخة"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp" />

</LinearLayout>
