<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- الهيدر العلوي -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="رجوع"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#C9D1D9" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="قاموس المصطلحات"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عدد المصطلحات: 0"
                android:textColor="#8B949E"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- حقل البحث -->
    <EditText
        android:id="@+id/etSearchGlossary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_status_item"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:hint="ابحث في القاموس..."
        android:paddingHorizontal="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#8B949E"
        android:textSize="14sp" />

    <!-- قائمة المصطلحات -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGlossaryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <!-- أزرار الإضافة والتصدير -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnAddTerm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#1F6FEB"
            android:text="إضافة مصطلح +"
            android:textColor="#FFFFFF"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnExportImport"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="استيراد / تصدير"
            android:textColor="#58A6FF"
            app:cornerRadius="10dp"
            app:strokeColor="#1F6FEB" />
    </LinearLayout>

</LinearLayout>
